## spinning up IBRK proxy hub
## note connection setup credentials exist in /trading/util/credential.json
00 9 * * 1-5 /trading/utils/notify.sh "hub=true" "python3 /trading/lib/hub_server.py" 
30 16 * * 1-5 pkill -f hub_server.py

