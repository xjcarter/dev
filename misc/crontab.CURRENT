15 8 * * 1-5 /trading/utils/notify.sh "hub=false" "python3 /trading/utils/lex_monitor2.py --sec_list=UPRO,SPY,ES1"

## kill and restart trading monitor - email alerts
## kill the old trading_alert monitor
55 8 * * * pkill -f trading_alert.py
## start the new log_alert monitor for the next 24hrs...
