# Edit this file to introduce tasks to be run by cron.
# 
# Each task to run has to be defined through a single line
# indicating with different fields when the task will be run
# and what command to run for the task
# 
# To define the time you can provide concrete values for
# minute (m), hour (h), day of month (dom), month (mon),
# and day of week (dow) or use '*' in these fields (for 'any').
# 
# Notice that tasks will be started based on the cron's system
# daemon's notion of time and timezones.
# 
# Output of the crontab jobs (including errors) is sent through
# email to the user the crontab file belongs to (unless redirected).
# 
# For example, you can run a backup of all your user accounts
# at 5 a.m every week with:
# 0 5 * * 1 tar -zcf /var/backups/home.tgz /home/
# 
# For more information see the manual pages of crontab(5) and cron(8)
# 
# m h  dom mon dow   command

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
PYTHONPATH=.:/trading/lib:/trading/utils
PORTFOLIO_DIRECTORY='/portfolio'
DATA_DIR='/trading/data/'
TZ='America/New_York'
ADMIN_MAIL='jcarter@hannibalinvestments.com'
MYSQL_HOSTNAME='96.126.109.155'
MYSQL_PASSWORD='Eleph@ntTusk123$'

### BITFARMS 

00 * * * * /root/sandbox/bitfarms/code/deribit_snapshot.sh 
00 * * * * /root/sandbox/bitfarms/code/bitnomial_snapshot.sh 

## turn off and restart bitnomial process every Sunday night
15 23 * * 7 pkill -f bitnomial_data.py 
45 23 * * 7 python3 /root/sandbox/bitfarms/code/bitnomial_data.py &

## transfer snapshots into folders
30 23 * * * /root/sandbox/bitfarms/code/transfer_data.sh

### END OF BITFARMS

## remove old auth_token_cache
00 6 * * * rm -fr /trading/utils/auth_token_cache.json

## contract roll reminder 
## check if we are in March - to include/roll to Jun, etc...
00 9 * * 1-5 /trading/utils/contract_reminder.py

## fetch historical data from yahoo.com
